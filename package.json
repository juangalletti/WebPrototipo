{
  "name": "contador_web",
  "version": "1.0.0",
  "description": "Servidor y dashboard del contador de personas (ESP32 + nRF24)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "simular": "node --env-file=.env scripts/simular-esp32.js",
    "css": "tailwindcss -i estilos/entrada.css -o public/app.css --minify",
    "css:watch": "tailwindcss -i estilos/entrada.css -o public/app.css --watch"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "private": true,
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
