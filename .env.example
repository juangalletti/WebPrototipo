# Copiar como .env para probar en la PC (en Railway se cargan en "Variables").
PORT=3000

# Clave que el ESP32 manda en la cabecera X-API-Key (la misma va en secrets.h del ESP32).
DEVICE_API_KEY=cambiar-por-una-clave-larga

# Usuario admin que se crea en el primer arranque (si la tabla de usuarios esta vacia).
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar-esta-contrasena

# Secreto para firmar las cookies de sesion (cualquier texto largo al azar).
SESSION_SECRET=cambiar-por-un-texto-largo-al-azar

# Solo en Railway: lo completa Railway al vincular la base PostgreSQL.
# DATABASE_URL=postgresql://...
